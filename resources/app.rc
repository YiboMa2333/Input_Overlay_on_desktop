   VALUE "ProductName", "Input Overlay Desktop"
   VALUE "LegalCopyright", "GPL-2.0-only. Includes Input Overlay, Copyright 2023 Alex. See NOTICE.md."
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
